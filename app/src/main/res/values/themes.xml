<resources>
    <!-- Classic Android styling. Material Components remains for legacy tool controls,
         but the app uses no Material 3 theme or Material 3 home-screen widgets. -->
    <style name="Theme.OpenTools" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#265BB4</item>
        <item name="colorPrimaryVariant">#173F85</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#3B746D</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="colorAccent">#265BB4</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:statusBarColor">?android:colorBackground</item>
        <item name="android:navigationBarColor">?android:colorBackground</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:colorAccent">#265BB4</item>
        <item name="materialButtonStyle">@style/Widget.OpenTools.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.OpenTools.Button.Outlined</item>
        <item name="materialCardViewStyle">@style/Widget.OpenTools.Card</item>
    </style>

    <style name="Widget.OpenTools.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="Widget.OpenTools.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
    </style>

    <style name="Widget.OpenTools.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">1dp</item>
    </style>
</resources>
